#!/bin/sh

####
# Zip latest syntax backup and copy to Google Drive
CWD=/srv/backup/syntax/daily.0/syntax
ZIP_FILE=../../syntax.zip

cd $CWD || exit

# Remove any existing zip backup
if [ -f $ZIP_FILE ]; then
    rm $ZIP_FILE
fi

# Zip up the most recent backup
/usr/bin/zip -q -P 'Facesol1!' -r $ZIP_FILE ./* > /dev/null 2>&1

# Copy to Google Drive
/usr/bin/rclone copy $ZIP_FILE drive:/Backup/syntax/

####
# Sync other backups to Google Drive
/usr/bin/rclone sync /srv/backup/gateway/ drive:/Backup/gateway/
/usr/bin/rclone copy /srv/backup/htpc/ drive:/Backup/htpc/
/usr/bin/rclone copy /srv/backup/htpc2/ drive:/Backup/htpc2/
/usr/bin/rclone copy /srv/backup/htpc3/ drive:/Backup/htpc3/
/usr/bin/rclone copy /srv/backup/htpc4/ drive:/Backup/htpc4/
/usr/bin/rclone sync /srv/backup/laptop/ drive:/Backup/laptop/
/usr/bin/rclone sync /srv/backup/phone/ drive:/Backup/phone/
/usr/bin/rclone sync /srv/backup/unifi/ drive:/Backup/unifi/

####
# rsync all backups to cislinux for off-site storage
rsync -az --delete --quiet --exclude '.zfs' /srv/backup/ cislinux:~/backup/

exit 0
