#!/bin/sh

###
# Generate device backups
BACKUP_PATH="/srv/backup"
GDRIVE_BACKUP_PATH=$BACKUP_PATH"/google_drive"
DEVICES_BACKUP_PATH=$BACKUP_PATH"/devices"
SYNTAX_BACKUP_PATH=$DEVICES_BACKUP_PATH"/syntax"
UNIFI_BACKUP_PATH=$DEVICES_BACKUP_PATH"/unifi"
GATEWAY_BACKUP_PATH=$DEVICES_BACKUP_PATH"/gateway"
SHARED_PATH="/srv/shared"

# Generate updated shared file directory listings to aid in recovery
find -O3 $SHARED_PATH/ -maxdepth 3 -type d -print | sort -h > $SYNTAX_BACKUP_PATH/misc/syntax_dirlist.txt
ls $SHARED_PATH/books/ > $SYNTAX_BACKUP_PATH/misc/books_list.txt
ls $SHARED_PATH/video/Movies/ > $SYNTAX_BACKUP_PATH/misc/movies_list.txt

# Zip latest syntax rsnapshot and copy to device backup
ZIP_FILE=$SYNTAX_BACKUP_PATH"/syntax.zip"

cd $BACKUP_PATH/rsnapshot/daily.0
if [ -f $ZIP_FILE ]; then
    rm $ZIP_FILE
fi
/usr/bin/zip -q -P 'Facesol1!' -r $ZIP_FILE ./* > /dev/null 2>&1

# rsync unifi backups
/usr/bin/rsync -a --delete --quiet /opt/appdata/unifi-controller/data/backup/autobackup/ $UNIFI_BACKUP_PATH/

# Generate gateway backup
ssh gateway tar -cz /config > $GATEWAY_BACKUP_PATH/gateway.tgz 2>/dev/null

###
# Sync all device backups to Google Drive
/usr/bin/rclone -q sync $DEVICES_BACKUP_PATH/ drive:/Backup/

# Sync Google Drive to backup directory
/usr/bin/rclone -q sync drive:/ $GDRIVE_BACKUP_PATH/

###
# rsync all backups to cislinux for off-site storage
/usr/bin/rsync -az --delete --quiet --exclude '.zfs' $BACKUP_PATH/ cislinux:~/backup/

# Run cislinux archive rotation script
ssh cislinux /home/k/kylhill/.local/bin/cislinux-archive.sh 2>/dev/null

exit 0
