#!/bin/sh

####
# Zip latest syntax rsnapshot and copy to device backup
CWD=/srv/backup/rsnapshot/daily.0/syntax
ZIP_FILE=/srv/backup/devices/syntax/syntax.zip

cd $CWD || exit

# Remove any existing zip backup
if [ -f $ZIP_FILE ]; then
    rm $ZIP_FILE
fi

# Zip up the most recent backup
/usr/bin/zip -q -P 'Facesol1!' -r $ZIP_FILE ./* > /dev/null 2>&1

####
# Sync all device backups to Google Drive
/usr/bin/rclone sync /srv/backup/devices/ drive:/Backup/

####
# rsync all backups to cislinux for off-site storage
rsync -az --delete --quiet --exclude '.zfs' /srv/backup/ cislinux:~/backup/

exit 0
