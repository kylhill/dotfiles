# Hostname aliases
Host syntax syntax-borg
    Hostname syntax.tacomafia.net

Host gateway gateway-borg
    Hostname gateway.l.tacomafia.net

Host oci oci-borg
    Hostname oci.vpn.tacomafia.net

Host htpc htpc? kvm wap wap2 sw-16
    Hostname %h.l.tacomafia.net

# Forward SSH agent to trusted hosts
Host syntax syntax.l.tacomafia.net syntax.tacomafia.net 192.168.1.30
    ForwardAgent yes
    VerifyHostKeyDNS yes

Host gateway gateway.l.tacomafia.net gateway.vpn.tacomafia.net gateway.tacomafia.net 192.168.1.1 192.168.6.1
    ForwardAgent yes
    VerifyHostKeyDNS yes

Host oci oci.vpn.tacomafia.net oci.tacomafia.net
    ForwardAgent yes
    VerifyHostKeyDNS yes

# HTPCs and KVM
Host htpc htpc.l.tacomafia.net htpc? htpc?.l.tacomafia.net kvm kvm.l.tacomafia.net
    User root

# Ubiquiti gear
Host wap wap.l.tacomafia.net wap2 wap2.l.tacomafia.net sw-16 sw-16.l.tacomafia.net
    IdentityFile ~/.ssh/ubnt-20220508
    HostKeyAlgorithms=+ssh-rsa
    PubkeyAcceptedKeyTypes=+ssh-rsa

# Forgejo git
Host git.tacomafia.net
    Port 2222
    User git

# Common borg config
Host syntax-borg gateway-borg oci-borg *.repo.borgbase.com
    BatchMode yes
    Compression no
    ControlMaster no
    IdentityFile ~/.ssh/id_borg
    IPQoS none
    StrictHostKeyChecking accept-new
    ServerAliveInterval 10
    ServerAliveCountMax 30

# Global config
Host *
    AddKeysToAgent yes
    Compression yes
    ControlMaster auto
    ControlPath ~/.cache/ssh-%r@%h:%p.sock
    ControlPersist 10m
    IdentityFile ~/.ssh/id_ed25519
    IPQoS ef none
    User kyleh
