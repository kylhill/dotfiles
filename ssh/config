# Include drop-in configs
Include ~/.ssh/config.d/*.conf

# Hostname aliases
Host syntax
    HostName syntax.tacomafia.net

Host gateway
    HostName gateway.l.tacomafia.net

Host oci
    HostName oci.vpn.tacomafia.net

Host htpc htpc? kvm wap wap? sw-16
    HostName %h.l.tacomafia.net

# Trusted Linux hosts
Host syntax syntax.tacomafia.net syntax.l.tacomafia.net gateway gateway.tacomafia.net gateway.*.tacomafia.net oci oci.tacomafia.net oci.vpn.tacomafia.net 192.168.1.30 192.168.?.1 192.168.6.6
    AddKeysToAgent yes
    ForwardAgent yes
    KbdInteractiveAuthentication no
    PasswordAuthentication no
    StrictHostKeyChecking accept-new
    UpdateHostKeys yes

# HTPCs and KVM
Host htpc htpc.l.tacomafia.net htpc? htpc?.l.tacomafia.net kvm kvm.l.tacomafia.net
    StrictHostKeyChecking accept-new
    User root

# Ubiquiti gear
Host wap wap.l.tacomafia.net wap? wap?.l.tacomafia.net sw-16 sw-16.l.tacomafia.net
    IdentityFile ~/.ssh/ubnt-20220508
    IdentitiesOnly yes
    HostKeyAlgorithms +ssh-rsa
    PubkeyAcceptedAlgorithms +ssh-rsa
    MACs +hmac-sha2-256
    StrictHostKeyChecking accept-new

# Forgejo git
Host git.tacomafia.net
    KbdInteractiveAuthentication no
    PasswordAuthentication no
    Port 2222
    StrictHostKeyChecking accept-new
    User git

# Global config
Host *
    ConnectTimeout 10
    ForwardAgent no
    HashKnownHosts yes
    IPQoS ef none
    ServerAliveCountMax 3
    ServerAliveInterval 60
    User kyleh
