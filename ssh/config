# Hostname aliases
Host syntax syntax-borg
    Hostname syntax.tacomafia.net

Host gateway gateway-borg
    Hostname gateway.l.tacomafia.net

Host oci oci-borg
    Hostname oci.vpn.tacomafia.net

Host htpc htpc[2-4] kvm wap wap2 sw-16
    Hostname %h.l.tacomafia.net

# Forward SSH agent to trusted hosts
Host syntax syntax.l.tacomafia.net syntax.tacomafia.net
    ForwardAgent yes

Host gateway gateway.l.tacomafia.net gateway.vpn.tacomafia.net
    ForwardAgent yes

Host oci oci.vpn.tacomafia.net oci.tacomafia.net
    ForwardAgent yes

# HTPCs and KVM
Host htpc htpc[2-4] htpc.l.tacomafia.net htpc[2-4].l.tacomafia.net kvm kvm.l.tacomafia.net
    User root

# Ubiquiti gear
Host wap wap2 wap.l.tacomafia.net wap2.l.tacomafia.net sw-16 sw-16.l.tacomafia.net
    IdentityFile ~/.ssh/ubnt-20220508
    HostKeyAlgorithms=+ssh-rsa
    PubkeyAcceptedKeyTypes=+ssh-rsa

# Forgejo git
Host git.tacomafia.net
    User git
    Port 2222
    VerifyHostKeyDNS no

# Common borg config
Host syntax-borg gateway-borg oci-borg *.repo.borgbase.com
    IdentityFile ~/.ssh/id_borg
    ServerAliveInterval 10
    ServerAliveCountMax 30
    ControlMaster no
    Compression no

# Global config
Host *
    User kyleh
    IdentityFile ~/.ssh/id_ed25519
    AddKeysToAgent yes
    VerifyHostKeyDNS yes
    ControlPath ~/.cache/ssh-%r@%h:%p.sock
    ControlMaster auto
    ControlPersist 10m
    Compression yes
