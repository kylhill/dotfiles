# Syntax
Host syntax syntax.l.tacomafia.net syntax.tacomafia.net tacomafia.net 192.168.1.30
    Port 993
    ForwardAgent yes

Host syntax-borg
    Hostname syntax.tacomafia.net
    Port 993

# Gateway
Host gateway gateway.l.tacomafia.net gateway.vpn.tacomafia.net 192.168.1.1 192.168.6.1
    ForwardAgent yes

# HTPCs
Host htpc htpc.l.tacomafia.net
    User root

Host htpc2 htpc2.l.tacomafia.net
    User root

Host htpc3 htpc3.l.tacomafia.net
    User root

Host htpc4 htpc4.l.tacomafia.net
    User root

# WAPs
Host wap*
    IdentityFile ~/.ssh/ubnt-20220508
    HostKeyAlgorithms=+ssh-rsa
    PubkeyAcceptedKeyTypes=+ssh-rsa

# GCP
Host gcp gcp.vpn.tacomafia.net gcp.tacomafia.net
    ForwardAgent yes

Host gcp-borg
    Hostname gcp.vpn.tacomafia.net

Host gcp-rsync
    Hostname gcp.vpn.tacomafia.net

# OCI
Host oci oci.vpn.tacomafia.net oci.tacomafia.net
    ForwardAgent yes

Host oci-borg
    Hostname oci.vpn.tacomafia.net

Host oci-rsync
    Hostname oci.vpn.tacomafia.net

# Common borg config
Host *-borg *.repo.borgbase.com
    IdentityFile ~/.ssh/id_borg
    ServerAliveInterval 10
    ServerAliveCountMax 30
    ControlMaster no

# Common rsync config
Host *-rsync
    IdentityFile ~/.ssh/id_rsync
    ControlMaster no

# Global config
Host *
    AddKeysToAgent yes
    VerifyHostKeyDNS yes
    ControlPath ~/.cache/ssh-%r@%h:%p.sock
    ControlMaster auto
    ControlPersist 10m
    User kyleh
