# Syntax
Host syntax syntax-borg
    Hostname syntax.l.tacomafia.net

Host syntax* 192.168.1.30
    ForwardAgent yes

# Gateway
Host gateway gateway-borg
    Hostname gateway.l.tacomafia.net

Host gateway* 192.168.*.1
    ForwardAgent yes

# HTPCs
Host htpc
    Hostname htpc.l.tacomafia.net

Host htpc2
    Hostname htpc2.l.tacomafia.net

Host htpc3
    Hostname htpc3.l.tacomafia.net

Host htpc4
    Hostname htpc4.l.tacomafia.net

Host htpc*
    User root

# WAPs
Host wap
    Hostname wap.l.tacomafia.net

Host wap2
    Hostname wap2.l.tacomafia.net

Host wap*
    IdentityFile ~/.ssh/ubnt-20220508
    HostKeyAlgorithms=+ssh-rsa
    PubkeyAcceptedKeyTypes=+ssh-rsa

# OCI
Host oci oci-borg
    Hostname oci.vpn.tacomafia.net

Host oci* 192.168.6.6
    ForwardAgent yes

# Common borg config
Host *-borg *.repo.borgbase.com
    IdentityFile ~/.ssh/id_borg
    ServerAliveInterval 10
    ServerAliveCountMax 30
    ControlMaster no

# Global config
Host *
    AddKeysToAgent yes
    VerifyHostKeyDNS yes
    ControlPath ~/.cache/ssh-%r@%h:%p.sock
    ControlMaster auto
    ControlPersist 10m
    User kyleh
