# Syntax
Host syntax syntax.l.tacomafia.net syntax.tacomafia.net tacomafia.net
    Hostname syntax.tacomafia.net
    Port 993
    ForwardAgent yes
    VerifyHostKeyDNS yes

Host syntax-borg
    Hostname syntax.tacomafia.net
    Port 993

# Gateway
Host gateway gateway.l.tacomafia.net
    Hostname gateway.l.tacomafia.net
    ForwardAgent yes
    VerifyHostKeyDNS yes

# HTPCs
Host htpc htpc.l.tacomafia.net
    Hostname htpc.l.tacomafia.net
    User root

Host htpc2 htpc2.l.tacomafia.net
    Hostname htpc2.l.tacomafia.net
    User root

Host htpc3 htpc3.l.tacomafia.net
    Hostname htpc3.l.tacomafia.net
    User root

Host htpc4 htpc4.l.tacomafia.net
    Hostname htpc4.l.tacomafia.net
    User root

# WAPs
Host wap wap.l.tacomafia.net
    Hostname wap.l.tacomafia.net

Host wap2 wap2.l.tacomafia.net
    Hostname wap2.l.tacomafia.net

Host wap*
    IdentityFile ~/.ssh/ubnt-20220508
    HostKeyAlgorithms=+ssh-rsa
    PubkeyAcceptedKeyTypes=+ssh-rsa

# GCP
Host gcp gcp.vpn.tacomafia.net
    Hostname gcp.vpn.tacomafia.net
    VerifyHostKeyDNS yes
    ForwardAgent yes

Host gcp-borg
    Hostname gcp.vpn.tacomafia.net

Host gcp-rsync
    Hostname gcp.vpn.tacomafia.net

# OCI
Host oci oci.vpn.tacomafia.net
    Hostname oci.vpn.tacomafia.net
    VerifyHostKeyDNS yes
    ForwardAgent yes

Host oci-borg
    Hostname oci.vpn.tacomafia.net

Host oci-rsync
    Hostname oci.vpn.tacomafia.net

# PVE
Host pve pve.l.tacomafia.net
    Hostname pve.l.tacomafia.net
    VerifyHostKeyDNS yes
    ForwardAgent yes

# Morbo
Host morbo morbo.l.tacomafia.net
    Hostname morbo.l.tacomafia.net
    VerifyHostKeyDNS yes
    ForwardAgent yes

# Common borg config
Host *-borg *.repo.borgbase.com
    IdentityFile ~/.ssh/id_borg
    ServerAliveInterval 10
    ServerAliveCountMax 30
    ControlMaster no

# Common rsync config
Host *-rsync
    IdentityFile ~/.ssh/id_rsync
    ControlMaster no

# Global config
Host *
    AddKeysToAgent yes
    ControlPath ~/.cache/ssh-%r@%h:%p.sock
    ControlMaster auto
    ControlPersist 10m
    User kyleh
