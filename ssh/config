# Forward SSH agent to trusted hosts
Host syntax* gateway* oci*
    ForwardAgent yes

# Syntax
Host syntax syntax-borg
    Hostname syntax.tacomafia.net

# Gateway
Host gateway gateway-borg
    Hostname gateway.l.tacomafia.net

# OCI
Host oci oci-borg
    Hostname oci.vpn.tacomafia.net

# Local aliases
Host htpc htpc? wap wap? sw-16 kvm
    Hostname %h.l.tacomafia.net

# HTPCs
Host htpc htpc? htpc.l.tacomafia.net htpc?.l.tacomafia.net
    User root

# WAPs and Switches
Host wap wap? sw-16 wap.l.tacomafia.net wap?.l.tacomafia.net sw-16.l.tacomafia.net
    IdentityFile ~/.ssh/ubnt-20220508
    HostKeyAlgorithms=+ssh-rsa
    PubkeyAcceptedKeyTypes=+ssh-rsa

# KVM
Host kvm kvm.l.tacomafia.net
    User root

# Git
Host git.tacomafia.net
    User git
    Port 2222
    VerifyHostKeyDNS no

# Common borg config
Host syntax-borg gateway-borg oci-borg *.repo.borgbase.com
    IdentityFile ~/.ssh/id_borg
    ServerAliveInterval 10
    ServerAliveCountMax 30
    ControlMaster no
    Compression no

# Global config
Host *
    User kyleh
    IdentityFile ~/.ssh/id_ed25519
    AddKeysToAgent yes
    VerifyHostKeyDNS yes
    ControlPath ~/.cache/ssh-%r@%h:%p.sock
    ControlMaster auto
    ControlPersist 10m
    Compression yes
