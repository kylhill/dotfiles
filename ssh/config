# Hostname aliases
Host syntax
    Hostname syntax.tacomafia.net

Host gateway
    Hostname gateway.l.tacomafia.net

Host oci
    Hostname oci.vpn.tacomafia.net

Host htpc htpc? kvm wap wap2 sw-16
    Hostname %h.l.tacomafia.net

# Forward SSH agent to trusted hosts
Host syntax syntax.l.tacomafia.net syntax.tacomafia.net 192.168.1.30
    ForwardAgent yes
    StrictHostKeyChecking accept-new
    VerifyHostKeyDNS ask

Host gateway gateway.l.tacomafia.net gateway.vpn.tacomafia.net gateway.tacomafia.net 192.168.1.1 192.168.6.1
    ForwardAgent yes
    StrictHostKeyChecking accept-new
    VerifyHostKeyDNS ask

Host oci oci.vpn.tacomafia.net oci.tacomafia.net
    ForwardAgent yes
    StrictHostKeyChecking accept-new
    VerifyHostKeyDNS ask
    Compression yes

# HTPCs and KVM
Host htpc htpc.l.tacomafia.net htpc? htpc?.l.tacomafia.net kvm kvm.l.tacomafia.net
    User root

# Ubiquiti gear (legacy RSA keys required - only for these devices)
Host wap wap.l.tacomafia.net wap2 wap2.l.tacomafia.net wap3 wap3.l.tacomafia.net sw-16 sw-16.l.tacomafia.net
    IdentityFile ~/.ssh/ubnt-20220508
    HostKeyAlgorithms=+ssh-rsa
    PubkeyAcceptedKeyTypes=+ssh-rsa
    StrictHostKeyChecking accept-new

# Forgejo git
Host git.tacomafia.net
    Port 2222
    User git
    Compression yes

# Global config
Host *
    AddKeysToAgent yes
    ControlMaster auto
    ControlPath ~/.cache/ssh-%r@%h:%p.sock
    ControlPersist 10m
    HashKnownHosts yes
    IdentityFile ~/.ssh/id_ed25519
    IPQoS ef none
    ServerAliveCountMax 3
    ServerAliveInterval 60
    User kyleh
