[core]
    whitespace = trailing-space,space-before-tab,cr-at-eol
    autocrlf = input
[push]
    autoSetupRemote = true
[pull]
    rebase = true
[user]
    name = Kyle Hill
    email = kylhill@gmail.com
    signingkey = E644A61F810BDC4D1294867A2E37EF3EA077FAD8
[init]
    defaultBranch = main
[alias]
    vlog = log --show-signature
[help]
    autocorrect = prompt
[diff]
    colorMoved = default
    mnemonicprefix = true
    algorithm = histogram
    wsErrorHighlight = all
    colorMovedWS = allow-indentation-change
[merge]
    conflictstyle = zdiff3
[rebase]
    autoSquash = true
[rerere]
    enabled = true
[safe]
    bareRepository = explicit
[log]
    date = short
[fetch]
    prune = true
