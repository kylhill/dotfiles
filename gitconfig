[color]
    ui = auto
[core]
    whitespace = trailing-space,space-before-tab,cr-at-eol
    autocrlf = input
[push]
    default = simple
[pull]
    rebase = true
[user]
    name = Kyle Hill
    email = kylhill@gmail.com
