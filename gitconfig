[color]
    ui = auto
[core]
    editor = nvim
    whitespace = fix,trailing-space,space-before-tab,cr-at-eol
    autocrlf = input
    fsmonitor = true
[push]
    default = simple
[pull]
    rebase = true
[user]
    name = Kyle Hill
    email = kylhill@gmail.com
    signingkey = 2E37EF3EA077FAD8
[github]
    user = kylhill
[init]
    defaultBranch = main
[gpg]
    program = gpg
[commit]
    gpgsign = true
[tag]
    gpgSign = true
[help]
    autocorrect = 1
[diff]
    colorMoved = default
    tool = nvimdiff
    mnemonicprefix = true
    renames = copies
    algorithm = histogram
    wsErrorHighlight = all
    colorMovedWS = allow-indentation-change
[merge]
    conflictstyle = diff3
    tool = nvimdiff
    renormalize = true
[rebase]
    autostash = true
    autoSquash = true
[fetch]
    prune = true
