[github]
    user = kylhill
[init]
    defaultBranch = main
[gpg]
    program = gpg
[help]
    autocorrect = 1
[diff]
    colorMoved = default
    mnemonicprefix = true
    renames = copies
    algorithm = histogram
    wsErrorHighlight = all
    colorMovedWS = allow-indentation-change
[merge]
    conflictstyle = diff3
    renormalize = true
[rebase]
    autostash = true
    autoSquash = true
[log]
    showSignature = true
    date = short
[transfer]
    fsckObjects = true
[fetch]
    fsckObjects = true
    prune = true
