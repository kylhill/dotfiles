" Kyle's customizations
"   http://dougblack.io/words/a-good-vimrc.html
"   https://github.com/amix/vimrc/blob/master/vimrcs/basic.vim

" Pathogen
execute pathogen#infect()

" General
set nocompatible
set autoread                    " set to autoread when a file is changed from the outside
set history=1000                " store lots of :cmdline history
set hidden                      " hide buffers when they are abandoned
set autowrite                   " automatically save before certain commands

" Colors and Fonts
syntax enable
set background=dark

if &t_Co < 256
    colorscheme default
    set nocursorline
else
    colorscheme solarized
    set cursorline
endif

" Spaces and Tabs
filetype plugin indent on
set autoindent
set tabstop=4       " number of spaces per tab
set softtabstop=4   " number of spaces in tab when editing
set expandtab       " tabs are spaces

" UI Config
set number          " show line numbers
set showcmd         " show command in bottom bar
set showmode        " show current mode in bottom bar
set wildmenu        " turn on the WiLd menu
set lazyredraw      " redraw only when we need to
set showmatch       " highlight matching [{()}]
set noruler         " turn off the ruler

" Searching
set incsearch       " search as characters are entered
set hlsearch        " highlight matches
set ignorecase      " do case insensitive matching
set smartcase       " do smart case matching

" NERDTree Config
"autocmd vimenter * NERDTree
autocmd bufenter * if (winnr("$") == 1 && exists("b:NERDTree") && b:NERDTree.isTabTree()) | q | endif
map <C-n> :NERDTreeToggle<CR>

" Have vim's cwd follow the current buffer
autocmd BufEnter * lcd %:p:h
